# Vercel / backend secrets
PAYLOAD_SECRET=replace-with-a-long-random-secret
PUBLIC_URL=https://YOUR-VERCEL-PROJECT.vercel.app
PAYLOAD_TTL_SECONDS=86400

# Pastefy API v2 token (server-side only)
PASTEFY_API_TOKEN=replace-with-your-pastefy-token

# Optional Upstash/Redis REST storage. Required for reliable multi-instance Vercel storage.
# You may use KV_REST_API_URL/KV_REST_API_TOKEN instead.
UPSTASH_REDIS_REST_URL=https://YOUR-INSTANCE.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-your-upstash-token
